{
  "host": "0.0.0.0",
  "port": @DEFAULT_PORT@,
  "wallpaperDir": "wallpapers",
  "malwareDir": "malware",
  @BOOT_KEYS@
  "musicExtensions": @DEFAULT_MUSIC_EXTENSIONS@,
  "openableExtensions": [
    @OPENABLE_EXTENSIONS_LIST@
  ],
  "useWallpapers": true,
  @BOOT_BOOL_KEYS@
  "useMusic": true,
  "useMalware": true,
  "useWinamp": true,
  "useSysSounds": true,
  "useTerminal": true,
  "useMessageBox": true,
  "useOpenRandom": true,
  "useDeleteRandom": true,
  "useDeleteSystem": true,
  "useReboot": true,
  "useCrash": true,
  "useMacroResolution": false,
  "useMicroResolution": true,
  "useColors": true,
  "useThemes": true,
  @XP_BOOL_KEYS@
  "warnAboutUrlsInTerminal": true,
  "loggingLevel": 0
}