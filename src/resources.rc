#if WINVER < _WIN32_WINNT_WINXP
  IDI_ICON1 ICON "../icon/win98.ico"
  IDI_LOGO IMAGE "../icon/win98.bmp"
#elif WINVER == _WIN32_WINNT_WINXP
  IDI_ICON1 ICON "../icon/winxp.ico"
  IDI_LOGO IMAGE "../icon/winxp.bmp"
#else
	#if WINVER < _WIN32_WINNT_WIN10
		IDI_ICON1 ICON "../icon/vista.ico"
		IDI_LOGO IMAGE "../icon/vista.bmp"
	#else
		IDI_ICON1 ICON "../icon/win10.ico"
		IDI_LOGO IMAGE "../icon/win10.bmp"
	#endif
  1 24 "app.manifest"
#endif